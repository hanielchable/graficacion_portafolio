function setup() {
  createCanvas(400, 400);
}

function draw() {
  background(220);

  fill(255, 204, 0);
  noStroke();
  rect(100, 100, 200, 200);

  fill(255, 0, 0);
  stroke(0);
  strokeWeight(4);
  circle(150, 160, 40);
  circle(250, 160, 40);

  fill(0);
  circle(150, 160, 15);
  circle(250, 160, 15);

  fill(255, 140, 0);
  triangle(200, 180, 185, 210, 215, 210);

  noFill();
  stroke(0);
  strokeWeight(3);
  rect(140, 220, 120, 30);

  stroke(255, 0, 0);
  strokeWeight(3);
  line(150, 240, 250, 240);

  fill(0, 0, 255, 120);
  stroke(255, 0, 0);
  strokeWeight(3);
  rect(125, 140, 150, 40, 5);
}
